# OpenRouter API Key — https://openrouter.ai/keys
# Required: provides the planner model (DeepSeek V3.2) and fallback executor/perception providers
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq API Key — https://console.groq.com/keys
# Optional: enables fastest executor model inference and Llama 4 Scout perception
# Also required for Whisper-based voice input (Settings → Speech Provider → Groq)
GROQ_API_KEY=your_groq_api_key_here
