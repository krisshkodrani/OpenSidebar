# Fireworks API Key - https://fireworks.ai
# Default E2E provider stack.
FIREWORKS_API_KEY=your_fireworks_api_key_here

# OpenRouter API Key - https://openrouter.ai/keys
# Optional: required only when using an OpenRouter provider mode.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Moonshot API Key - https://platform.kimi.ai
# Optional: required when using the direct Moonshot/Kimi provider mode.
KIMI_API_KEY=your_kimi_api_key_here

# Hugging Face token - https://huggingface.co/settings/tokens
# Optional: required for real WorkArena gated instance metadata access.
HUGGING_FACE_HUB_TOKEN=your_hugging_face_token_here
