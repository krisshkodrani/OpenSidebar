# OpenRouter is the only LLM gateway. Use the dedicated OpenSidebar key.
# Configure its monthly spending limit in OpenRouter, not in this file.
OPENROUTER_API_KEY=your_openrouter_api_key_here
E2E_PROVIDER=openrouter

# Hugging Face token - https://huggingface.co/settings/tokens
# Optional: required for real WorkArena gated instance metadata access.
HUGGING_FACE_HUB_TOKEN=your_hugging_face_token_here

# Fleet telemetry is compiled only into an explicit internal extension build
# (`vite build --mode internal`). Leave unset for published builds.
FLEET_TELEMETRY_INTERNAL_ENDPOINT=

# Interactive remote tasks remain off until browser acceptance and credential rotation.
HOSTED_MCP_INTERACTIVE_ENABLED=false
VITE_REMOTE_INTERACTIVE_ENABLED=false
