# OpenRouter API Key - Get from https://openrouter.ai
# Required: provides the fallback LLM provider and smart model access
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq API Key - Get from https://console.groq.com
# Optional: enables fastest perception (Llama 4 Scout) and Whisper voice input
GROQ_API_KEY=your_groq_api_key_here

# Cerebras API Key - Get from https://cloud.cerebras.ai
# Optional: enables fastest inference (~3000 TPS) for both fast and smart tiers
CEREBRAS_API_KEY=your_cerebras_api_key_here
