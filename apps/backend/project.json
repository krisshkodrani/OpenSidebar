{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "backend",
  "projectType": "application",
  "sourceRoot": "apps/backend/src",
  "tags": ["scope:backend", "type:app"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "eslint \"apps/backend/src/**/*.ts\" \"apps/backend/tests/**/*.ts\""
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "vitest run --config apps/backend/vitest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/.tsbuild/apps/backend"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "tsc -b apps/backend/tsconfig.json"
      }
    },
    "serve-standalone": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "tsx apps/backend/src/server.ts"
      }
    }
  }
}
