{
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "name": "fixture-online-shop-pro",
  "projectType": "application",
  "sourceRoot": "apps/extension/tests/e2e/fixtures/online-shop-pro/src",
  "tags": ["scope:fixture", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "vite build"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "vite --host 127.0.0.1"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "vite preview --host 127.0.0.1"
      }
    }
  }
}
