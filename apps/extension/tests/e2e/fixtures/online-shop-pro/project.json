{
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "name": "fixture-online-shop-pro",
  "projectType": "application",
  "sourceRoot": "apps/extension/tests/e2e/fixtures/online-shop-pro/src",
  "tags": ["scope:fixture", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "npm --prefix apps/extension/tests/e2e/fixtures/online-shop-pro run build"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "npm --prefix apps/extension/tests/e2e/fixtures/online-shop-pro run dev"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "npm --prefix apps/extension/tests/e2e/fixtures/online-shop-pro run preview"
      }
    }
  }
}
