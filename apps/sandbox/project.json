{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "sandbox",
  "projectType": "application",
  "sourceRoot": "apps/sandbox/src",
  "tags": ["scope:sandbox", "type:app"],
  "targets": {
    "build": { "executor": "nx:run-commands", "outputs": ["{projectRoot}/dist"], "options": { "cwd": "{workspaceRoot}", "command": "vite build --config apps/sandbox/vite.config.ts" } },
    "dev": { "executor": "nx:run-commands", "cache": false, "options": { "cwd": "{workspaceRoot}", "command": "vite --config apps/sandbox/vite.config.ts" } },
    "typecheck": { "executor": "nx:run-commands", "options": { "cwd": "{workspaceRoot}", "command": "tsc -p apps/sandbox/tsconfig.json" } }
  }
}
