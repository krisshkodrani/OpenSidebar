{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Challenge Task Manifest",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "taskId",
      "title",
      "entryUrl",
      "discoverySource",
      "score"
    ],
    "properties": {
      "taskId": {
        "type": "string",
        "pattern": "^task-[0-9]{2}$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "entryUrl": {
        "type": "string",
        "format": "uri"
      },
      "discoverySource": {
        "type": "string",
        "enum": ["dom", "route", "mixed"]
      },
      "score": {
        "type": "number",
        "minimum": 0
      }
    },
    "additionalProperties": false
  }
}
