POSTGRES_PASSWORD=replace-with-a-long-random-password
PLAYGROUND_DB_PASSWORD=replace-with-a-different-long-random-password
CONTROL_DB_PASSWORD=replace-with-a-third-long-random-password
CONTROL_ORIGIN=https://opensidebar.com
TARGET_ORIGIN=https://play.opensidebar.com
AWS_REGION=eu-central-1
BACKUP_BUCKET=replace-with-private-backup-bucket
BACKUP_DAILY_RETENTION_DAYS=7
BACKUP_WEEKLY_RETENTION_DAYS=28
BACKUP_AGE_RECIPIENT=age1replace-with-offline-recovery-public-key
COGNITO_DOMAIN=https://replace.auth.eu-central-1.amazoncognito.com
COGNITO_CLIENT_ID=replace-with-public-client-id
AUTH_QUOTA_HMAC_KEY=replace-with-a-long-random-hmac-key
# LP-28 cloud control remains disabled until the pinned extension/Cognito/KMS acceptance pass.
CLOUD_CONTROL_ENABLED=false
EXTENSION_AUTH_ENABLED=false
CREDENTIAL_WRITES_ENABLED=false
RELAY_ENABLED=false
PREFERENCE_WRITES_ENABLED=false
OPENSIDEBAR_EXTENSION_ID=replace-with-pinned-chrome-extension-id
COGNITO_EXTENSION_CLIENT_ID=replace-with-public-extension-client-id
CREDENTIAL_KMS_KEY_ID=alias/opensidebar-credentials
CLOUD_TESTER_SUBJECTS=comma-separated-cognito-subjects
RELAY_MODEL_ALLOWLIST=comma-separated-reviewed-model-ids
# LP-34 E2EE trace sync remains independently disabled through verification.
TRACE_SYNC_ENABLED=false
TRACE_UPLOADS_ENABLED=false
TRACE_DOWNLOADS_ENABLED=false
TRACE_TESTER_SUBJECTS=comma-separated-cognito-subjects
TRACE_BUCKET_NAME=replace-with-private-versioned-trace-bucket
# Dedicated IAM user only; never reuse an administrator credential. Keep this file root-readable only.
OPENSIDEBAR_KMS_ACCESS_KEY_ID=replace-with-dedicated-access-key-id
OPENSIDEBAR_KMS_SECRET_ACCESS_KEY=replace-with-dedicated-secret-access-key
# Shared PlayScenario host only:
# PLAYGROUND_POSTGRES_CONTAINER=playscenario-db-1
# PLAYGROUND_DB_USER=playground_service
# PLAYGROUND_DB_NAME=opensidebar
