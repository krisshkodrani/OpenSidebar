[Unit]
Description=OpenSidebar Lightsail application stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/opensidebar
EnvironmentFile=/etc/opensidebar/playground.env
ExecStart=/usr/bin/docker compose -f infra/lightsail/compose.yaml up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose -f infra/lightsail/compose.yaml down
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
