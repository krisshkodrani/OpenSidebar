{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/.eslintrc.cjs",
      "{workspaceRoot}/vite.config.ts",
      "{workspaceRoot}/vitest.config.ts"
    ],
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/tests/**",
      "!{projectRoot}/node_modules/**",
      "!{projectRoot}/dist/**",
      "!{projectRoot}/dist-dev/**"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ]
    },
    "check": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": []
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ]
    },
    "typecheck": {
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{workspaceRoot}/.tsbuild/{projectRoot}"
      ]
    },
    "validate": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "outputs": []
    }
  },
  "analytics": false
}
