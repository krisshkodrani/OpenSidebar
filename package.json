{
  "name": "opensidebar",
  "version": "0.1.0",
  "type": "module",
  "description": "AI-powered browser agent that can see, click, and navigate the web",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenSidebar/OpenSidebar.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "bun run --bun vite",
    "build": "bun run --bun vite build",
    "lint": "bun run --bun eslint src --ext .ts,.tsx",
    "test": "bun test",
    "fmt": "bun run --bun prettier --write src/",
    "logs": "bun run scripts/log-server.ts",
    "logs:query": "bun run scripts/log-query.ts",
    "logs:tail": "bun run scripts/log-query.ts tail",
    "logs:errors": "bun run scripts/log-query.ts errors",
    "traces": "bun run scripts/trace-query.ts",
    "traces:list": "bun run scripts/trace-query.ts list",
    "traces:stats": "bun run scripts/trace-query.ts stats",
    "evals": "bun run evals/cli.ts",
    "evals:convert": "bun run evals/cli.ts convert",
    "evals:run": "bun run evals/cli.ts run",
    "evals:stats": "bun run evals/cli.ts stats",
    "evals:analyze": "bun run evals/cli.ts analyze",
    "evals:critique": "bun run evals/cli.ts critique",
    "challenge:discover": "bun run scripts/challenge-discover.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@xenova/transformers": "^2.17.2",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "immer": "^10.1.1",
    "lucide-react": "^0.416.0",
    "marked": "^17.0.1",
    "pdfjs-dist": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.11.0",
    "tailwind-merge": "^2.4.0",
    "uuid": "^10.0.0",
    "voy-search": "^0.6.3",
    "yaml": "^2.8.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@happy-dom/global-registrator": "^20.5.0",
    "@types/bun": "^1.3.8",
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.5.0",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-plugin-static-copy": "^3.2.0"
  }
}

