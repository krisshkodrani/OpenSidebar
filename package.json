{
  "name": "opensidebar",
  "version": "0.8.0",
  "type": "module",
  "description": "AI-powered browser agent that can see, click, and navigate the web",
  "repository": {
    "type": "git",
    "url": "https://github.com/krisshkodrani/OpenSidebar.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/krisshkodrani/OpenSidebar#readme",
  "bugs": {
    "url": "https://github.com/krisshkodrani/OpenSidebar/issues"
  },
  "keywords": [
    "chrome-extension",
    "browser-agent",
    "ai-agent",
    "browser-automation",
    "llm",
    "web-agent",
    "manifest-v3"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx scripts/dev-stack.ts",
    "build": "npm run prompts:build && npm run prompts:check && tsx scripts/vite-clean.ts build",
    "typecheck": "tsc -b",
    "test": "vitest run --config apps/extension/vitest.config.ts",
    "test:all": "npm test && npm run test:backend",
    "lint": "eslint \"apps/extension/src/**/*.{ts,tsx}\" \"apps/extension/tests/**/*.{ts,tsx}\" \"apps/backend/src/**/*.ts\" \"apps/backend/tests/**/*.ts\" \"packages/**/*.{ts,tsx}\" \"scripts/**/*.ts\" --ignore-pattern \"apps/extension/tests/e2e/fixtures/**\" --ignore-pattern \"scripts/run-e2e-progressive.ts\"",
    "ci:lint": "npm run lint",
    "ci:test": "npm run test:all",
    "ci:build": "npm run build",
    "ci:dist": "node scripts/check-dist.js",
    "ci:local": "npm run ci:lint && npm run typecheck && npm run ci:test && npm run ci:build && npm run ci:dist",
    "release:verify": "npm run ci:local",
    "fmt": "prettier --write apps/extension/src/ packages/",
    "fixtures": "tsx scripts/serve-fixtures.ts",
    "backend": "tsx apps/backend/src/server.ts",
    "test:backend": "vitest run --config apps/backend/vitest.config.ts",
    "logs": "tsx scripts/log-server.ts",
    "logs:tail": "tsx scripts/log-query.ts tail",
    "logs:errors": "tsx scripts/log-query.ts errors",
    "traces": "tsx scripts/trace-query.ts",
    "test:e2e": "tsx scripts/run-e2e-staged.ts",
    "test:e2e:all": "npm run build && npm run fixtures:build && vitest run --config apps/extension/tests/e2e/vitest.e2e.config.ts",
    "test:e2e:smoke": "tsx scripts/run-e2e-staged.ts smoke",
    "test:e2e:interactions": "tsx scripts/run-e2e-staged.ts interaction-regression",
    "test:e2e:runtime": "tsx scripts/run-e2e-staged.ts runtime-regression",
    "test:e2e:nightly": "tsx scripts/run-e2e-staged.ts nightly-legacy",
    "test:e2e:workarena": "tsx scripts/run-e2e-arena.ts --tag workarena-gap",
    "test:e2e:workarena:variance": "tsx scripts/run-e2e-arena.ts --tag workarena-gap --repeat 3",
    "test:e2e:workarena:copy": "tsx scripts/workarena-copy-suite.ts",
    "benchmark:workarena:setup": "tsx scripts/workarena-setup.ts",
    "benchmark:workarena:doctor": "tsx scripts/workarena-doctor.ts",
    "benchmark:workarena:list": "tsx scripts/workarena-list.ts",
    "benchmark:workarena:first-task": "tsx scripts/workarena-first-task.ts",
    "benchmark:workarena:category-coverage": "tsx scripts/workarena-category-coverage.ts",
    "benchmark:workarena:adapter": "tsx scripts/workarena-adapter.ts",
    "benchmark:workarena:dry": "tsx scripts/workarena-dry.ts",
    "benchmark:workarena:run": "tsx scripts/workarena-run.ts",
    "benchmark:workarena:local": "tsx scripts/workarena-local-execution.ts",
    "benchmark:workarena:browser-strategy": "tsx scripts/workarena-browser-strategy.ts",
    "benchmark:workarena:held-session": "tsx scripts/workarena-held-session.ts",
    "benchmark:workarena:handoff": "tsx scripts/workarena-handoff.ts",
    "benchmark:workarena:trace-learning": "tsx scripts/workarena-trace-learning.ts",
    "benchmark:workarena:validate-reports": "tsx scripts/workarena-validate-reports.ts",
    "test:e2e:staged": "tsx scripts/run-e2e-staged.ts",
    "test:e2e:visible": "tsx scripts/run-e2e-visible-demo.ts",
    "test:e2e:easy": "npm run test:e2e:smoke",
    "test:e2e:medium": "npm run test:e2e:interactions",
    "test:e2e:hard": "npm run test:e2e:runtime",
    "test:e2e:regression": "npm run test:e2e:interactions",
    "test:e2e:progressive": "tsx scripts/run-e2e-progressive.ts",
    "e2e:arena:list": "tsx scripts/e2e-arena.ts",
    "e2e:arena:check": "tsx scripts/e2e-arena.ts",
    "e2e:arena:report": "tsx scripts/e2e-arena.ts --report",
    "e2e:arena:run": "tsx scripts/run-e2e-arena.ts",
    "fixtures:build": "npm --prefix apps/extension/tests/e2e/fixtures/online-shop-pro run build",
    "prompts:build": "tsx scripts/build-prompts.ts",
    "prompts:check": "tsx scripts/check-inline-prompts.ts"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@mozilla/readability": "^0.6.0",
    "@tanstack/react-virtual": "^3.13.19",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "idb": "^8.0.3",
    "immer": "^10.1.1",
    "lucide-react": "^0.416.0",
    "marked": "^17.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0",
    "turndown": "^7.2.2",
    "uuid": "^10.0.0",
    "yaml": "^2.8.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@happy-dom/global-registrator": "^20.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chrome": "^0.0.268",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "better-sqlite3": "^12.9.0",
    "cron-parser": "^5.5.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.5.0",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "puppeteer": "^24.38.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^3.0.0"
  }
}
