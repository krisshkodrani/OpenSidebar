{
  "name": "opensidebar",
  "version": "0.3.0",
  "type": "module",
  "description": "AI-powered browser agent that can see, click, and navigate the web",
  "repository": {
    "type": "git",
    "url": "https://github.com/krisshkodrani/OpenSidebar.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/krisshkodrani/OpenSidebar#readme",
  "bugs": {
    "url": "https://github.com/krisshkodrani/OpenSidebar/issues"
  },
  "keywords": [
    "chrome-extension",
    "browser-agent",
    "ai-agent",
    "browser-automation",
    "llm",
    "web-agent",
    "manifest-v3"
  ],
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/backend",
    "apps/extension",
    "apps/extension/tests/e2e/fixtures/online-shop-pro",
    "packages/prompts",
    "packages/shared-types"
  ],
  "scripts": {
    "dev": "nx run tools:dev-stack",
    "build": "nx run extension:build",
    "test": "nx run-many -t test --projects=extension,backend",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "ci": "nx affected -t lint,typecheck,test,build",
    "e2e": "nx run extension:test-e2e-staged",
    "logs": "nx run tools:local-server",
    "traces": "nx run tools:traces",
    "ci:lint": "nx run-many -t lint",
    "ci:test": "nx run-many -t test --projects=extension,backend",
    "ci:build": "nx run extension:build",
    "ci:dist": "node scripts/check-dist.js",
    "ci:local": "npm run ci:lint && npm run typecheck && npm run ci:test && npm run ci:build && npm run ci:dist",
    "release:verify": "npm run ci:local",
    "fmt": "prettier --write apps/extension/src/ packages/",
    "fixtures": "nx run tools:fixtures",
    "fixtures:build": "nx run fixture-online-shop-pro:build",
    "backend:standalone": "nx run backend:serve-standalone",
    "test:backend": "nx run backend:test",
    "logs:tail": "nx run tools:logs-tail",
    "logs:errors": "nx run tools:logs-errors",
    "test:e2e": "nx run extension:test-e2e-staged",
    "test:e2e:staged": "nx run extension:test-e2e-staged",
    "test:e2e:easy": "nx run extension:test-e2e-easy",
    "test:e2e:medium": "nx run extension:test-e2e-medium",
    "test:e2e:hard": "nx run extension:test-e2e-hard",
    "test:e2e:smoke": "nx run extension:test-e2e-easy",
    "test:e2e:interactions": "nx run extension:test-e2e-medium",
    "test:e2e:runtime": "nx run extension:test-e2e-hard",
    "prompts:build": "nx run prompts-package:build",
    "prompts:check": "nx run prompts-package:check",
    "review:deepseek": "tsx scripts/deepseek-review.ts"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@mozilla/readability": "^0.6.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.19",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "idb": "^8.0.3",
    "immer": "^10.1.1",
    "lucide-react": "^0.416.0",
    "marked": "^17.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0",
    "turndown": "^7.2.2",
    "uuid": "^10.0.0",
    "yaml": "^2.8.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@happy-dom/global-registrator": "^20.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chrome": "^0.0.268",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "better-sqlite3": "^12.9.0",
    "cron-parser": "^5.5.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.5.0",
    "nx": "^22.7.0",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "puppeteer": "^24.38.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^3.0.0"
  }
}
