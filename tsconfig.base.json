{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/extension/src/*"],
      "@shared-types": ["./packages/shared-types/src/index.ts"],
      "@shared-types/*": ["./packages/shared-types/src/*"],
      "@observability-schema": ["./packages/observability-schema/src/index.ts"],
      "@observability-schema/*": ["./packages/observability-schema/src/*"],
      "@prompts": ["./packages/prompts/src/index.ts"],
      "@prompts/*": ["./packages/prompts/src/*"],
      "@sandbox-contracts": ["./packages/sandbox-contracts/src/index.ts"],
      "@opensidebar/scenario-contracts": ["./packages/scenario-contracts/src/index.ts"],
      "@opensidebar/scenario-engine": ["./packages/scenario-engine/src/index.ts"],
      "@trace-sync": ["./packages/trace-sync/src/index.ts"]
    },
    "types": ["chrome"]
  }
}
